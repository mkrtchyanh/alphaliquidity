C4Component
    title Tenant Service - Component Diagram (C4 Level 3)

    Container(gateway, "API Gateway", "ASP.NET Core", "Entry point.")
    Container(offers, "Sell Offer Service", ".NET", "Authorization queries.")
    Container(comp, "Compliance Gateway", ".NET", "Onboarding and status.")
    Container(bal, "Balance Service", "ASP.NET Core", "Funding requests.")
    ContainerDb(tendb, "Tenant Store", "Relational DB", "Tenants, users, roles, credentials.")
    ContainerQueue(kafka, "Kafka", "Kafka", "Domain events.")
    System_Ext(idp, "Identity Provider", "SSO / OIDC, MFA.")
    System_Ext(notify, "Notification Service", "Email and webhooks.")

    Container_Boundary(svc, "Tenant Service") {
        Component(registry, "Tenant Registry", ".NET", "Tenant profile and status: onboarding, active, suspended.")
        Component(users, "User and Role Manager", ".NET", "Users, roles (trader, admin, approver, viewer) and permissions.")
        Component(authz, "Authorization Service", "REST", "Answers whether a user in a tenant may perform an action. Used by other subsystems.")
        Component(cred, "Credential Manager", ".NET", "API credentials, rotation and IP allow-lists.")
        Component(idpi, "Identity Integration", "OIDC client", "Login, MFA and optional federation with the fund's identity provider.")
        Component(iso, "Tenant Isolation Filter", "Middleware", "Applies the tenant to every read and write so no tenant sees another tenant's data.")
        Component(onbf, "Onboarding Facade", ".NET", "Starts onboarding in Compliance and tracks its progress.")
        Component(fundf, "Funding Request Facade", ".NET", "Forwards deposit and withdrawal requests to the Balance Service and tracks status.")
        Component(statush, "Status Event Handler", ".NET", "Reacts to Party approved or suspended by enabling or blocking logins.")
        Component(prefs, "Notification Settings", ".NET", "Channels, webhooks and event subscriptions per tenant.")
        Component(repo, "Tenant Repository", "Data access", "Stores tenants, users, roles, credentials and settings.")
    }

    Rel(gateway, registry, "Tenant admin", "HTTPS")
    Rel(gateway, users, "User admin", "HTTPS")
    Rel(gateway, cred, "Credentials", "HTTPS")
    Rel(gateway, fundf, "Funding requests", "HTTPS")
    Rel(offers, authz, "Authorize", "REST")
    Rel(authz, users, "Reads roles")
    Rel(authz, registry, "Reads tenant status")
    Rel(users, idpi, "Identities")
    Rel(idpi, idp, "OIDC")
    Rel(registry, onbf, "New tenant")
    Rel(onbf, comp, "Onboarding", "REST")
    Rel(fundf, bal, "Funding", "REST")
    Rel(kafka, statush, "Party status events", "Subscribe")
    Rel(statush, registry, "Updates status")
    Rel(prefs, notify, "Dispatch", "API")
    Rel(kafka, prefs, "Events to notify", "Subscribe")
    Rel(iso, repo, "Scopes every query")
    Rel(registry, iso, "Uses")
    Rel(users, iso, "Uses")
    Rel(repo, tendb, "SQL")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")