C4Component
    title Sell Offer Management Service - Component Diagram (C4 Level 3)

    Container(gateway, "API Gateway", "ASP.NET Core", "Authenticates, rate limits.")
    ContainerDb(somdb, "Offer Store", "Relational DB", "Drafts, pricing breakdown, rules.")
    Container(tenant, "Tenant Service", "ASP.NET Core", "Authorization.")
    Container(comp, "Compliance Service", "ASP.NET Core", "Eligibility and limits.")
    Container(bal, "Balance Service", "ASP.NET Core", "Balance check and reserve(debit),release(credit).")
    Container(offers, "Sell Offer Service", "ASP.NET Core", "Trading state.")
    Container(ld, "Market Data Feed", "Reference prices.")

    Container_Boundary(svc, "Sell Offer Management Service") {
        Component(api, "Offer API", "REST / gRPC", "Create, edit, withdraw and list offers. Requires an idempotency key on create.")
        Component(wf, "Offer Creation Workflow", "Saga, .NET", "Runs Draft, Validating, Published. Reserves and Releases assets block.")
        Component(authz, "Authorization Client", "gRPC client", "Checks user, role and tenant status.")
        Component(val, "Validation Engine", ".NET", "Checks pair, volume and price limits from configured rules.")
        Component(guard, "Market Price Guard", ".NET", "Compares supplier price with the cached reference price and rejects off-market offers.")
        Component(mcache, "Reference Price Cache", "In-memory cache", "Latest price per pair with timestamp and staleness limit.")
        Component(elig, "Eligibility Client", "gRPC client", "Checks supplier approval, permitted pair and size limits.")
        Component(price, "Pricing Engine", ".NET", "Builds the listed price from supplier price plus markup. Stores the breakdown for audit and spread reporting.")
        Component(rules, "Rules and Pair Configuration", ".NET", "Markup rules, pair settings, size and deviation limits. Managed by the Platform Operator.")
        Component(pub, "Offer Publisher", "gRPC client", "Publishes the offer to Sell Offer Service. Requests withdrawal or expiry.")
        Component(feed, "Supplier Feed Adapter", "Worker", "Accepts prices and inventory from Liquidity Providers and turns them into offers.")
        Component(hold, "Hold Timeout Sweeper", "Background worker", "Releases holds of offers that were never published.")
        Component(repo, "Offer Repository", "Data access", "Stores offers, status, pricing breakdown and failure reasons.")
    }

    Rel(gateway, api, "Offer commands", "HTTPS")
    Rel(api, wf, "Start creation")
    Rel(wf, authz, "Authorize")
    Rel(authz, tenant, "Query", "HTTPS")
    Rel(wf, val, "Validate input")
    Rel(val, rules, "Reads limits")
    Rel(wf, guard, "Price check")
    Rel(guard, mcache, "Reads reference price")
    Rel(market, mcache, "Price updates", "Feed")
    Rel(wf, elig, "Eligibility")
    Rel(wf, bal, "Check and reserve a block(credit)")
    Rel(elig, comp, "Query", "HTTPS")
    Rel(wf, price, "Build listed price")
    Rel(price, rules, "Reads markup")
    Rel(wf, pub, "Publish")
    Rel(pub, offers, "Command", "HTTPS")
    Rel(offers, wf, "State changes", "Events")
    Rel(offers, feed, "Prices and inventory", "API / feed")
    Rel(feed, wf, "Create offers")
    Rel(wf, repo, "Reads and writes")
    Rel(repo, somdb, "SQL")
    Rel(hold, repo, "Finds unpublished offers")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
