C4Component
    title Balance Service - Component Diagram (C4 Level 3)

    Container(offers, "Sell Offer Service", ".NET", "Transaction requested call.")
    Container(gateway, "API Gateway", ".NET", "Balance reads and funding requests.")
    ContainerDb(baldb, "Balance DB", "MS SQL Server", "Credit and debit records, exchange records, outbox. CDC reads the outbox from the WAL.")
    ContainerQueue(kafka, "Kafka", "Kafka", "Payment transactions in, outcome events out.")
    Container(settleadp, "Settlement Adapter", "Worker", "Bank, blockchain and custody flows.")
    System_Ext(accounting, "Accounting / Finance Reporting", "Books.")

    Container_Boundary(svc, "Balance Service") {
        Component(api, "Balance API", "REST", "Transaction requested (sync), balance reads, funding requests.")
        Component(request, "Request Handler", ".NET", "Checks eligible balance and creates the REQUESTED records atomically per account: buyer debit (price + margin), seller credit, platform fee credit.")
        Component(payment, "Payment Consumer", ".NET", "Consumes the payment transaction. In ONE transaction: records REQUESTED to EXECUTED (if not expired) and the exchange record inserted. Otherwise PaymentRejected. Idempotent by event id.")
        Component(records, "Record Manager", ".NET", "Credit and debit records with source id and source type. Only REQUESTED to EXECUTED or REJECTED. EXECUTED is final. Corrections are new compensating records.")
        Component(calc, "Balance Calculator", ".NET", "Eligible balance: EXECUTED credits + EXECUTED and REQUESTED debits. Actual: EXECUTED only. Estimated: EXECUTED + REQUESTED.")
        Component(expiry, "Expiry Sweeper", "Background worker", "Records past their TTL are no longer counted. Marks them REJECTED.")
        Component(fund, "Funding Handler", ".NET", "Deposit and withdrawal requests. Withdrawal uses the eligible balance.")
        Component(accts, "Account Manager", ".NET", "Accounts per Party and currency.")
        Component(repo, "Balance Repository", "Data access", "Records, exchange records. Writes the outbox row in the same commit.")
        Component(recon, "Reconciliation", "Background worker", "Compares balances with records and settlement confirmations.")
        Component(export, "Journal Exporter", "Background worker", "Exports journals and snapshots for accounting.")
    }

    Rel(offers, api, "Transaction requested", "REST, sync")
    Rel(gateway, api, "Balance reads, funding requests", "HTTPS")
    Rel(api, request, "Create REQUESTED records")
    Rel(api, calc, "Balance reads")
    Rel(api, fund, "Funding requests")
    Rel(kafka, payment, "Payment transaction")
    Rel(request, records, "Create")
    Rel(payment, records, "Finalize")
    Rel(request, calc, "Eligible balance")
    Rel(expiry, records, "Reject expired")
    Rel(fund, records, "Credit or debit")
    Rel(fund, settleadp, "Instructions and confirmations")
    Rel(records, accts, "Account state")
    Rel(records, repo, "Persist")
    Rel(calc, repo, "Reads")
    Rel(repo, baldb, "SQL")
    Rel(baldb, kafka, "ExchangeCompleted, PaymentRejected", "Outbox, CDC")
    Rel(recon, repo, "Reads")
    Rel(export, repo, "Reads")
    Rel(export, accounting, "Journals", "Batch")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")